# .env.example — copie para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore)

# Banco de dados
DB_PATH=database.db

# Regras de negócio
LOAN_DAYS=15
FINE_PER_DAY=3

# SMTP (e-mail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=sua_biblioteca@gmail.com
SENDER_PASSWORD=sua_senha_de_app_aqui

# Credenciais do admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha

# Cashfree (pagamentos)
CASHFREE_API_KEY=sua_chave_aqui
CASHFREE_SECRET=seu_secret_aqui
